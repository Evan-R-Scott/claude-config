# --- Oh My Zsh Configuration ---
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

# zsh-autosuggestions and zsh-syntax-highlighting are cloned by install-dotfiles.sh
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh
# -------------------------------

# --- Environment Paths & Settings ---
export PATH="$HOME/.local/bin:${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

setopt histignorealldups sharehistory
bindkey -e

# Ubuntu ships bat as batcat
command -v batcat >/dev/null 2>&1 && alias bat='batcat'

# --- Custom Functions ---
# Open WezTerm (Windows side) in the current directory. WSL only.
if [ -n "$WSL_DISTRO_NAME" ]; then
  wez() {
    local win_path=$(wslpath -w "$PWD")
    /mnt/c/Program\ Files/WezTerm/wezterm-gui.exe start --cwd "$win_path" -- wsl.exe
  }
fi

# --- nvm (loaded only when installed) ---
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# --- Machine-local overrides (untracked): API keys, tokens, per-machine tweaks ---
[ -f "$HOME/.zshrc.local" ] && . "$HOME/.zshrc.local"
